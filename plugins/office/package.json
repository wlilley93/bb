{
  "name": "bb-plugin-bb--office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open Word, PowerPoint, Excel, and PDF files in WordCraft, DeckCraft, GridCraft, and PdfCraft.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.113"
  },
  "bb": {
    "name": "Office files",
    "description": "Open Word, PowerPoint, Excel, and PDF files in WordCraft, DeckCraft, GridCraft, and PdfCraft.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern vendor .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
