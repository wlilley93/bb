{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "app.tsx",
    "app.test.tsx",
    "craft-apps.ts",
    "craft-apps.test.ts",
    "craft-cache.ts",
    "craft-cache.test.ts",
    "host-page.ts",
    "host-page.test.ts",
    "office-source.ts",
    "office-source.test.ts",
    "vitest.config.ts"
  ]
}
